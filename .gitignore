# Keep the project README, durable design/contract docs, and engineering
# architecture docs tracked; other planning notes remain local-only.
*.md
!README.md
!PRODUCT.md
!DESIGN.md
docs/*
!docs/architecture
!docs/architecture/**
!docs/architecture/**/**
!docs/frontend-backend-handoff.md

DevGuard_PRD.md

# Dependencies
node_modules/

# Build outputs
dist/
build/
.next/
*.tsbuildinfo
*.d.mts
*.d.mts.map

# Test and coverage artifacts
coverage/
.vite/
.vitest/

# Environment and secrets — never commit populated env files.
.env
.env.*
!.env.example

# Local scratch / preserved-not-shipped scaffolding (e.g. C015 partial work)
.scratch/

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.log

var/artifacts/
.vercel
.cursor/
