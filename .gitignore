# Keep only the project README and engineering architecture docs tracked;
# planning documents remain local-only.
*.md
!README.md
docs/*
!docs/architecture
!docs/architecture/**
!docs/architecture/**/**

DevGuard_PRD.md

# Dependencies
node_modules/

# Build outputs
dist/
build/
*.tsbuildinfo
*.d.mts
*.d.mts.map

# Test and coverage artifacts
coverage/
.vite/
.vitest/

# Environment and secrets — never commit populated env files.
.env
.env.*
!.env.example

# Local scratch / preserved-not-shipped scaffolding (e.g. C015 partial work)
.scratch/

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.log
