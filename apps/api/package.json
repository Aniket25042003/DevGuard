{
  "name": "@devguard/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DevGuard API composition root and transport shell (transport lands with C005).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/main.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@devguard/agent": "workspace:*",
    "@devguard/artifact-storage": "workspace:*",
    "@devguard/api-contracts": "workspace:*",
    "@devguard/approvals": "workspace:*",
    "@devguard/auth": "workspace:*",
    "@devguard/authorization": "workspace:*",
    "@devguard/config": "workspace:*",
    "@devguard/contracts": "workspace:*",
    "@devguard/db": "workspace:*",
    "@devguard/errors": "workspace:*",
    "@devguard/github-adapter": "workspace:*",
    "@devguard/logging": "workspace:*",
    "@devguard/policy-engine": "workspace:*",
    "@devguard/queue": "workspace:*",
    "@devguard/sandbox": "workspace:*",
    "@devguard/workflows": "workspace:*",
    "@hono/node-server": "^1.14.4",
    "hono": "^4.9.7",
    "ioredis": "^5.4.1"
  }
}
