{
  "$schema": "http://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@devguard/contracts": ["packages/contracts/src/index.ts"],
      "@devguard/errors": ["packages/errors/src/index.ts"],
      "@devguard/api-contracts": ["packages/api-contracts/src/index.ts"],
      "@devguard/auth": ["packages/auth/src/index.ts"],
      "@devguard/authorization": ["packages/authorization/src/index.ts"],
      "@devguard/config": ["packages/config/src/index.ts"]
    },
    "plugins": []
  }
}
