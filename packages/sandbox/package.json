{
  "name": "@devguard/sandbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Isolated command execution sandbox (C041-C044): workspace checkout, authorized timed commands, resource/egress limits and secure artifact cleanup.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@devguard/contracts": "workspace:*",
    "@devguard/errors": "workspace:*",
    "@devguard/logging": "workspace:*",
    "zod": "^4.1.12"
  }
}
