{
  "name": "devguard",
  "private": true,
  "version": "0.0.0",
  "description": "DevGuard — GitHub-focused autonomous software-engineering governance control plane.",
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=26.7.0 <27"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force && pnpm --filter @devguard/web build",
    "typecheck": "tsc -b tsconfig.json && pnpm --filter @devguard/web typecheck",
    "lint": "eslint . && node scripts/check-boundaries.mjs && node scripts/ci/check-workflow-policy.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "tsc -b tsconfig.json && vitest run --project unit --project web",
    "test:watch": "vitest --project unit",
    "test:integration": "node scripts/ci/run-integration.mjs",
    "test:e2e": "tsc -b tsconfig.json && vitest run --project e2e",
    "local": "node scripts/local/local.mjs up",
    "local:down": "node scripts/local/local.mjs down",
    "local:reset": "node scripts/local/local.mjs reset",
    "local:status": "node scripts/local/local.mjs status",
    "doctor": "node scripts/local/local.mjs doctor",
    "db:migrate": "node scripts/local/local.mjs migrate",
    "db:seed": "node scripts/local/local.mjs seed",
    "db:reset": "node scripts/local/local.mjs reset",
    "test:services:up": "node scripts/local/local.mjs test-up",
    "test:services:down": "node scripts/local/local.mjs test-down",
    "test:services:reset": "node scripts/local/local.mjs test-reset",
    "start:api": "node apps/api/dist/main.js",
    "start:worker": "node apps/worker/dist/main.js",
    "start:web": "pnpm --filter @devguard/web start",
    "deploy:preflight": "node scripts/deploy/preflight.mjs",
    "deploy:manifest": "node scripts/deploy/release-manifest.mjs",
    "demo:preflight": "node scripts/demo/evidence-manifest.mjs",
    "demo:verify": "node scripts/demo/evidence-manifest.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.3.0",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4",
    "jsdom": "^26.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/dom": "^10.4.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
