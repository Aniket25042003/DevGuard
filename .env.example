# DevGuard environment template (C002).
#
# Rules:
# - Names only. NEVER populate real secret values in this file or in any
#   committed environment file.
# - Every variable here is registered in packages/config/src/schema.ts; the
#   parity tests enforce that this file and the schema stay aligned.
# - Unknown DEVGUARD_*/FLAG_*/PUBLIC_* variables fail CI and warn in development.

# --- Process environment -----------------------------------------------------
DEVGUARD_ENV=development

# --- Durable infrastructure (secret references) ------------------------------
DATABASE_URL=
REDIS_URL=

# --- Authentication (C005) ---------------------------------------------------
AUTH_MODE=github_oauth
AUTH_SESSION_SECRET=
AUTH_GITHUB_OAUTH_CLIENT_ID=
AUTH_GITHUB_OAUTH_CLIENT_SECRET=
AUTH_GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback

# --- GitHub App (C017/C022) --------------------------------------------------
DEVGUARD_GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
DEVGUARD_GITHUB_API_BASE_URL=https://api.github.com

# --- TrueForge runtime (C036) — disabled by default --------------------------
DEVGUARD_TRUEFORGE_BASE_URL=
TRUEFORGE_API_KEY=
DEVGUARD_TRUEFORGE_TIMEOUT_MS=30000

# --- Artifact storage (C012) -------------------------------------------------
DEVGUARD_ARTIFACT_DRIVER=local
DEVGUARD_ARTIFACT_LOCAL_DIR=.data/artifacts
DEVGUARD_S3_ENDPOINT=
DEVGUARD_S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Retention defaults (days) -----------------------------------------------
DEVGUARD_RETENTION_AUDIT_DAYS=365
DEVGUARD_RETENTION_WORKFLOW_EVENT_DAYS=90
DEVGUARD_RETENTION_ARTIFACT_DAYS=30
DEVGUARD_RETENTION_TRANSCRIPT_DAYS=30

# --- Limits ------------------------------------------------------------------
DEVGUARD_WEBHOOK_MAX_BODY_BYTES=1048576
DEVGUARD_MAX_ACTIVE_RUNS_PER_REPOSITORY=3

# --- Sessions & origin (C005) -------------------------------------------------
DEVGUARD_PUBLIC_ORIGIN=http://localhost:3000
DEVGUARD_SESSION_IDLE_MINUTES=60
DEVGUARD_SESSION_ABSOLUTE_HOURS=24

# --- Observability -----------------------------------------------------------
DEVGUARD_LOG_LEVEL=info

# --- Feature flags (strict booleans; all default false) ----------------------
# FLAG_GITHUB_WRITES_ENABLED=false
# FLAG_TRUEFORGE_INTEGRATION_ENABLED=false
# FLAG_SANDBOX_EXECUTION_ENABLED=false
# FLAG_WEBHOOK_INGRESS_ENABLED=false
# FLAG_APPROVAL_EXECUTION_ENABLED=false
# FLAG_DEV_NO_AUTH_MODE=false

# --- Browser-allowed public values -------------------------------------------
PUBLIC_API_BASE_URL=http://localhost:4000
